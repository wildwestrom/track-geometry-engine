import TrackGeometry.Lib

/-! # Fixture dump for the Teal port

`lake exe fixtures [out]` runs `buildPath` over a set of PI fixtures and writes the result
as a Lua table (default `mod/test/fixtures.lua`), which `mod/test/geometry_test.lua` checks
the Teal port (`tg_geometry.script.tl`) against. Every float is written as its IEEE-754 bit
pattern in hex, so nothing is lost to decimal formatting. -/

namespace Fixtures

def rf (x : Float) : RFloat := ⟨x⟩

/-- A float as a quoted 16-digit hex bit pattern. -/
def hex (x : RFloat) : String :=
  let d := Nat.toDigits 16 x.val.toBits.toNat
  "\"" ++ String.join (List.replicate (16 - d.length) "0") ++ String.join (d.map Char.toString) ++ "\""

/-- The UI's design parameters (`TrackGeometry.UI.Config.designParams`). -/
def dpDefault : DesignParams RFloat :=
  { legBudget := rf 0.3, minRadius := rf 100.0, straightThreshold := rf 0.001,
    maxLateralAccel := rf 1.2, maxLateralJerk := rf 0.5, maxYawAccel := rf 0.2,
    maxDesignSpeed := rf 83.3333 }

/-- Speed model off: pure circular fillets. -/
def dpNoSpeed : DesignParams RFloat := { dpDefault with maxLateralAccel := rf 0 }

/-- Every corner takes half of each leg, so corners on a shared leg meet with a zero-length
    straight between them. -/
def dpHalf : DesignParams RFloat := { dpDefault with legBudget := rf 0.5 }

structure Fixture where
  name : String
  dp : DesignParams RFloat := dpDefault
  pis : Array (Float × Float)
  /-- Per-PI tangent budget overrides, indexed like `pis`. -/
  overrides : Array (Option Float) := #[]

def fixtures : Array Fixture := #[
  { name := "left corner", pis := #[(0, 0), (400, 0), (700, 300)] },
  { name := "right corner", pis := #[(0, 0), (400, 0), (700, -300)] },
  { name := "S curve", pis := #[(0, 0), (300, 0), (600, 200), (900, 100), (1200, 250)] },
  { name := "near-straight corner", pis := #[(0, 0), (500, 0), (1000, 0.1)] },
  { name := "sharp corner, short legs", pis := #[(0, 0), (100, 0), (60, 80)] },
  { name := "pure fillet", dp := dpNoSpeed, pis := #[(0, 0), (400, 0), (700, 300)] },
  { name := "overrides", pis := #[(0, 0), (300, 0), (600, 200), (900, 100), (1200, 250)],
    overrides := #[none, some 20, some 500, none, none] },
  { name := "two points", pis := #[(10, 20), (310, 420)] },
  { name := "duplicate PI", pis := #[(0, 0), (200, 0), (200, 0), (400, 100)] },
  { name := "corners meet", dp := dpHalf, pis := #[(0, 0), (300, 0), (300, 300), (600, 300)] }
]

def kindAndRadius (e : AnySegment RFloat) : String × RFloat :=
  match e with
  | ⟨_, _, .straight .., _⟩ => ("straight", 0)
  | ⟨_, _, .arc r .., _⟩ => ("arc", r)
  | ⟨_, _, .transitionIn r .., _⟩ => ("in", r)
  | ⟨_, _, .transitionOut r .., _⟩ => ("out", r)

def vec (pre : String) (v : Vec3 RFloat) : String :=
  s!"{pre}x = {hex (v 0)}, {pre}y = {hex (v 1)}, {pre}z = {hex (v 2)}"

/-- A segment, sampled at five evenly spaced local arc-lengths. -/
def dumpSegment (e : AnySegment RFloat) : String :=
  let (kind, r) := kindAndRadius e
  let len := e.length
  let samples := (List.range 5).map fun k =>
    let t := len * natToScalar k / natToScalar 4
    s!"      \{ t = {hex t}, {vec "" (e.pointAt t)}, {vec "t" (e.tangentAt t)}, k = {hex (e.curvatureAt t)} },\n"
  s!"    \{ kind = \"{kind}\", radius = {hex r}, length = {hex len}, opSpeed = {hex e.opSpeed}, samples = \{\n"
    ++ String.join samples ++ "    } },\n"

def dumpFixture (f : Fixture) : String :=
  let pts := f.pis.map fun (x, y) => Vec3.mk (rf x) (rf y) 0
  let path := buildPath pts f.dp (f.overrides.map (·.map rf))
  let dp := f.dp
  let params := s!"legBudget = {hex dp.legBudget}, minRadius = {hex dp.minRadius}, " ++
    s!"straightThreshold = {hex dp.straightThreshold}, maxLateralAccel = {hex dp.maxLateralAccel}, " ++
    s!"maxLateralJerk = {hex dp.maxLateralJerk}, maxYawAccel = {hex dp.maxYawAccel}, " ++
    s!"maxDesignSpeed = {hex dp.maxDesignSpeed}"
  let pis := String.join (pts.toList.map fun p => s!"\{ {hex (p 0)}, {hex (p 1)} }, ")
  let overrides := String.join ((List.range f.overrides.size).filterMap fun i =>
    (f.overrides[i]?).bind id |>.map fun o => s!"[{i + 1}] = {hex (rf o)}, ")
  s!"  \{ name = \"{f.name}\",\n    params = \{ {params} },\n    pis = \{ {pis}},\n" ++
    s!"    overrides = \{ {overrides}},\n    length = {hex path.length},\n    segments = \{\n" ++
    String.join (path.segments.toList.map dumpSegment) ++ "  } },\n"

end Fixtures

def main (args : List String) : IO Unit := do
  let out := args.headD "mod/test/fixtures.lua"
  IO.FS.writeFile out <|
    "-- Generated by `lake exe fixtures` (Fixtures.lean). Do not edit.\n" ++
    "-- Floats are IEEE-754 bit patterns in hex.\nreturn {\n" ++
    String.join (Fixtures.fixtures.toList.map Fixtures.dumpFixture) ++ "}\n"
  IO.println s!"wrote {Fixtures.fixtures.size} fixtures to {out}"
